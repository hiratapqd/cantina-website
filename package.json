{
  "name": "casinha-azul",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de comandas da cantina e livraria Casinha Azul",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "demo": "node scripts/demo.js",
    "test": "node --test --test-isolation=none",
    "check": "node --check src/server.js && node --check public/js/app.js",
    "db:check": "node connect_mongodb.js",
    "db:prepare": "node scripts/prepare-database.js",
    "catalog:import": "node scripts/import-catalog.js"
  },
  "engines": { "node": ">=24 <25" },
  "dependencies": {
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.1",
    "zod": "^4.6.7"
  }
}
