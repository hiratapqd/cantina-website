# Exemplo local. Copie para .env somente se ainda não tiver sua configuração.
# A demonstração no Render usa render.yaml e dispensa MONGODB_URI.
# Para um serviço com banco real, configure MONGODB_URI no painel do Render.
MONGODB_URI=mongodb://127.0.0.1:27017/cantina_casinha_Azul

# mongodb: banco configurado. demo: dados isolados em memória.
DATA_MODE=mongodb
PORT=3000
# Em produção: NODE_ENV=production, HOST=0.0.0.0 e chave aleatória persistente.
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
