<section class="page-heading"><div><p class="eyebrow">ADMINISTRAÇÃO DA CASA</p><h1>Visão geral</h1><p class="subtitle">Um olhar sobre a cantina, a livraria e os cuidados do dia.</p></div><div class="heading-actions"><span class="date-label"><%= new Intl.DateTimeFormat('pt-BR', {timeZone:'America/Sao_Paulo',day:'numeric',month:'long',year:'numeric'}).format(new Date()) %></span><a class="button" href="/relatorios"><svg class="icon" aria-hidden="true"><use href="#i-chart"/></svg>Ver relatórios</a></div></section>
<section class="welcome-band"><div class="welcome-icon"><svg class="icon" aria-hidden="true"><use href="#i-home"/></svg></div><div><h2>O dia da Casinha Azul, em um só lugar.</h2><p>Acompanhe os recebimentos e encontre o que precisa de atenção.</p></div><span class="welcome-tag">Cantina · Livraria · Comunidade</span></section>
<section class="metrics" aria-label="Resumo de hoje">
  <article class="metric"><div class="metric-top"><span>Recebido hoje</span><span class="metric-icon teal"><svg class="icon" aria-hidden="true"><use href="#i-chart"/></svg></span></div><strong class="metric-value"><%= money(stats.received) %></strong><span class="metric-detail"><span class="tiny-dot teal-bg"></span><%= stats.paid.length %> comandas pagas hoje</span></article>
  <a class="metric" href="/comandas"><div class="metric-top"><span>Comandas abertas</span><span class="metric-icon blue"><svg class="icon" aria-hidden="true"><use href="#i-receipt"/></svg></span></div><strong class="metric-value"><%= stats.open.length %><small>comandas</small></strong><span class="metric-detail"><%= money(stats.pending) %> a receber <span class="inline-arrow">↗</span></span></a>
  <a class="metric" href="/relatorios?type=estoque"><div class="metric-top"><span>Atenção ao estoque</span><span class="metric-icon amber"><svg class="icon" aria-hidden="true"><use href="#i-box"/></svg></span></div><strong class="metric-value"><%= stats.low.length %><small>produtos</small></strong><span class="metric-detail"><span class="tiny-dot amber-bg"></span>No mínimo ou abaixo <span class="inline-arrow">↗</span></span></a>
  <a class="metric" href="/livraria"><div class="metric-top"><span>Acervo da livraria</span><span class="metric-icon purple"><svg class="icon" aria-hidden="true"><use href="#i-book"/></svg></span></div><strong class="metric-value"><%= books.filter(i=>i.active).reduce((a,i)=>a+i.stock,0) %><small>exemplares</small></strong><span class="metric-detail"><%= books.filter(i=>i.active).length %> títulos e condições <span class="inline-arrow">↗</span></span></a>
</section>
<div class="dashboard-grid">
  <section class="panel chart-panel"><div class="panel-heading"><div><h2>Recebimentos da semana</h2><p>Valores recebidos nos últimos 7 dias</p></div><span class="subtle-pill">Últimos 7 dias</span></div><div class="chart-summary"><strong><%= money(stats.days.reduce((a,d)=>a+d.total,0)) %></strong><span>Total no período</span></div><div class="bar-chart" role="img" aria-label="Recebimentos dos últimos sete dias"><% const max=Math.max(...stats.days.map(d=>d.total),1); for(const [index,day] of stats.days.entries()){ %><div class="bar-column"><span class="bar-tooltip"><%= money(day.total) %></span><div class="bar-track"><div class="bar <%= index===6?'today-bar':'' %>" style="height:<%= Math.max(day.total/max*100,day.total?5:0) %>%"></div></div><span class="bar-label"><%= day.label %></span><span class="sr-only"><%= money(day.total) %></span></div><% } %></div></section>
  <section class="panel payments-panel"><div class="panel-heading"><div><h2>Formas de pagamento</h2><p>Recebimentos de hoje</p></div></div><% const pix=stats.received?stats.payments[0].total/stats.received*100:0;const debit=stats.received?stats.payments[1].total/stats.received*100:0; %><div class="donut" style="--pix:<%= pix %>%;--debit:<%= pix+debit %>%" role="img" aria-label="Distribuição dos pagamentos de hoje"><div><span>Total recebido</span><strong><%= money(stats.received) %></strong></div></div><div class="payment-legend"><% for(const [i,p] of stats.payments.entries()){ %><div><span><i class="legend-dot color-<%= i %>"></i><%= p.name %></span><strong><%= money(p.total) %></strong></div><% } %></div></section>
</div>
<div class="dashboard-grid lower-grid">
  <section class="panel"><div class="panel-heading"><div><h2>Comandas recentes</h2><p>Últimos registros recebidos pelo sistema</p></div><a class="text-link" href="/comandas?status=todas">Ver todas <span aria-hidden="true">→</span></a></div><% if(!stats.recent.length){ %><%- include('partials/empty',{message:'Nenhuma comanda recebida ainda.',detail:'As comandas aparecerão aqui quando forem registradas pela integração.'}) %><% }else{ %><div class="table-wrap"><table><thead><tr><th>Comanda</th><th>Nome</th><th>Situação</th><th class="numeric">Total</th><th><span class="sr-only">Abrir</span></th></tr></thead><tbody><% for(const order of stats.recent){ %><tr><td><a class="record-link" href="/comandas/<%= order._id %>">#<%= order.number %></a></td><td><%= order.name || 'Somente número' %></td><td><span class="badge <%= order.status==='paga'?'positive':'pending' %>"><%= order.status==='paga'?'Paga':'Aberta' %></span></td><td class="numeric money"><%= money(order.totalCents) %></td><td><a class="row-link" href="/comandas/<%= order._id %>" aria-label="Abrir comanda <%= order.number %>">↗</a></td></tr><% } %></tbody></table></div><% } %></section>
  <section class="panel quick-panel"><div class="panel-heading"><div><h2>Acessos rápidos</h2><p>As tarefas mais frequentes</p></div></div><a class="quick-link" href="/cantina/novo"><span class="metric-icon blue"><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg></span><span><strong>Cadastrar produto</strong><small>Inclua um item no catálogo</small></span><span>→</span></a><a class="quick-link" href="/estoque"><span class="metric-icon teal"><svg class="icon" aria-hidden="true"><use href="#i-stock"/></svg></span><span><strong>Movimentar estoque</strong><small>Registre entradas e ajustes</small></span><span>→</span></a><a class="quick-link" href="/sincronizacao"><span class="metric-icon purple"><svg class="icon" aria-hidden="true"><use href="#i-sync"/></svg></span><span><strong>Sincronização Clover</strong><small><%= devices.length ? 'Consultar último envio recebido' : 'Nenhum dispositivo cadastrado' %></small></span><span>→</span></a></section>
</div>
