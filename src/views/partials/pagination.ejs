<% if(pages>1){const pageUrl=n=>{const params=new URLSearchParams(query);params.set('page',n);return path+'?'+params.toString();}; %><nav class="pagination" aria-label="Paginação"><span>Página <%= currentPage %> de <%= pages %></span><div><% if(currentPage>1){ %><a class="button secondary small" href="<%= pageUrl(currentPage-1) %>">Anterior</a><% } %><% if(currentPage<pages){ %><a class="button secondary small" href="<%= pageUrl(currentPage+1) %>">Próxima</a><% } %></div></nav><% } %>
