<section class="page-heading"><div><p class="eyebrow">ATENDIMENTO</p><h1>Comandas</h1><p class="subtitle">Consulte pedidos abertos e recebimentos, sempre pelo número.</p></div><a class="button secondary" href="/sincronizacao"><svg class="icon" aria-hidden="true"><use href="#i-sync"/></svg>Sincronização</a></section>
<div class="section-tabs"><a href="/comandas" class="<%= !query.status?'selected':'' %>">Abertas</a><a href="/comandas?status=pagas" class="<%= query.status==='pagas'?'selected':'' %>">Pagas</a><a href="/comandas?status=todas" class="<%= query.status==='todas'?'selected':'' %>">Todas</a></div>
<section class="panel"><form class="filter-bar wrap" method="get"><input type="hidden" name="status" value="<%= query.status||'' %>"><label class="search-field"><svg class="icon" aria-hidden="true"><use href="#i-search"/></svg><span class="sr-only">Buscar número ou nome</span><input name="q" value="<%= query.q||'' %>" placeholder="Buscar número ou nome…" maxlength="120"></label><label><span class="sr-only">Forma de pagamento</span><select name="payment"><option value="">Todos os pagamentos</option><% for(const [key,label] of Object.entries(paymentNames)){ %><option value="<%= key %>" <%= query.payment===key?'selected':'' %>><%= label %></option><% } %></select></label><label class="compact-label">De<input type="date" name="from" value="<%= query.from||'' %>"></label><label class="compact-label">Até<input type="date" name="to" value="<%= query.to||'' %>"></label><button class="button secondary">Filtrar</button></form><div class="table-caption"><span><%= total %> comandas encontradas</span><strong>Total da seleção: <%= money(balance) %></strong></div><% if(!rows.length){ %><%- include('partials/empty',{message:'Nenhuma comanda encontrada.',detail:'Ajuste os filtros ou aguarde o recebimento de novas comandas.'}) %><% }else{ %><div class="table-wrap"><table><thead><tr><th>Comanda</th><th>Nome <span class="optional">opcional</span></th><th>Data</th><th>Situação</th><th>Pagamento</th><th class="numeric">Total</th><th></th></tr></thead><tbody><% for(const order of rows){ %><tr><td><a class="record-link" href="/comandas/<%= order._id %>">#<%= order.number %></a></td><td><%= order.name||'Somente número' %></td><td><%= dateTime(order.paidAt||order.createdAt) %></td><td><span class="badge <%= order.status==='paga'?'positive':'pending' %>"><%= order.status==='paga'?'Paga':'Aberta' %></span></td><td><%= paymentNames[order.payment]||'A receber' %></td><td class="numeric money"><%= money(order.totalCents) %></td><td><a class="text-link" href="/comandas/<%= order._id %>">Detalhes</a></td></tr><% } %></tbody></table></div><% } %><%- include('partials/pagination') %></section><p class="page-footnote">Comandas sem nome são identificadas pelo número. O painel consulta os registros; o atendimento e o recebimento pela Clover serão conectados em etapa própria.</p>
