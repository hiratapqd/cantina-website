<section class="page-heading"><div><p class="eyebrow">ACOMPANHAMENTO</p><h1>Relatórios</h1><p class="subtitle">Informação para planejar compras e acompanhar a casa.</p></div><div class="heading-actions"><button type="button" class="button secondary" data-print>Imprimir</button><a class="button" href="/relatorios/exportar.csv?<%= new URLSearchParams(query).toString() %>"><svg class="icon" aria-hidden="true"><use href="#i-download"/></svg>Exportar CSV</a></div></section>
<section class="panel"><form class="filter-bar wrap" method="get"><label class="grow">Relatório<select name="type"><% for(const [key,label] of Object.entries(report.types)){ %><option value="<%= key %>" <%= report.type===key?'selected':'' %>><%= label %></option><% } %></select></label><% if(report.type==='livraria'){ %><label>Visão da livraria<select name="view"><option value="periodo">No período</option><option value="acumulado" <%= report.view==='acumulado'?'selected':'' %>>Acumulado por dias</option><option value="faixas" <%= report.view==='faixas'?'selected':'' %>>Faixas de dias</option><option value="sem-vendas" <%= report.view==='sem-vendas'?'selected':'' %>>Sem vendas em 60 dias</option></select></label><% } %><label>Data inicial<input type="date" name="from" value="<%= report.range.from %>" required></label><label>Data final<input type="date" name="to" value="<%= report.range.to %>" required></label><button class="button">Consultar</button></form></section>
<div class="report-heading"><div><h2><%= report.title %></h2><p><%= ['estoque','parados'].includes(report.type)?'Situação atual do catálogo':report.range.from.split('-').reverse().join('/')+' a '+report.range.to.split('-').reverse().join('/') %></p></div><% if(!['estoque','parados','movimentacoes'].includes(report.type)){ %><div class="report-total"><span>Total do período</span><strong><%= money(report.totalCents) %></strong></div><% } %></div>
<% if(report.type!=='recebimentos'){ %><div class="info-note"><%= ['estoque','parados'].includes(report.type)?'O saldo reflete os dados disponíveis no servidor. Lançamentos ainda não sincronizados na Clover não estão incluídos.':report.type==='movimentacoes'?'Entradas, saídas e correções registradas pela administração.':'Quantidades e valores dos itens lançados no período, inclusive em comandas abertas. Consulte Recebimentos para os valores efetivamente pagos.' %></div><% } %>
<section class="panel"><% if(!report.rows.length){ %><%- include('partials/empty',{message:'Sem registros para esta consulta.',detail:'Escolha outro período ou confira os registros do catálogo.'}) %><% }else if(['estoque','parados'].includes(report.type)){ %><div class="table-wrap"><table><thead><tr><th>Produto / livro</th><th>Condição</th><th class="numeric">Atual</th><th class="numeric">Mínimo</th><th>Último lançamento</th><th>Ação</th></tr></thead><tbody><% for(const row of report.rows){ %><tr><td><strong><%= row.name %></strong><small class="cell-note"><%= row.code %></small></td><td><%= row.condition||'—' %></td><td class="numeric"><%= row.stock %></td><td class="numeric"><%= row.minStock %></td><td><%= row.last?dateTime(row.last):'Sem vendas desde o cadastro' %></td><td><a class="text-link" href="/estoque?kind=<%= row.kind %>&id=<%= row.id %>">Movimentar</a></td></tr><% } %></tbody></table></div><% }else if(report.type==='livraria' && ['acumulado','faixas','sem-vendas'].includes(report.view)){ %><div class="padded form-help">Quantidades de exemplares por ISBN e condição, com referência em <%= report.range.to.split('-').reverse().join('/') %>. Acumulado inclui os últimos N dias; faixas não se sobrepõem: 0–29, 30–59, 60–89, 90–179 e 180–364 dias. "Sem vendas" inclui títulos sem lançamentos nos últimos 60 dias, inclusive cadastros recentes.</div><div class="table-wrap"><table><thead><tr><th>Livro / ISBN</th><th>Condição</th><th class="numeric">Estoque</th><th>Última venda</th><% for(const label of (report.view==='faixas'?['0–29','30–59','60–89','90–179','180–364']:['30d','60d','90d','180d','365d'])){ %><th class="numeric"><%= label %></th><% } %></tr></thead><tbody><% for(const row of report.rows){ %><tr><td><strong><%= row.name %></strong><small class="cell-note"><%= row.code %></small></td><td><%= row.condition %></td><td class="numeric"><%= row.stock %></td><td><%= row.last?dateTime(row.last):'Nunca vendido' %></td><% for(const n of (report.view==='faixas'?row.bands:row.cumulative)){ %><td class="numeric"><%= n %></td><% } %></tr><% } %></tbody></table></div><% }else if(report.type==='movimentacoes'){ %><div class="table-wrap"><table><thead><tr><th>Data</th><th>Item</th><th>Motivo</th><th class="numeric">Variação</th><th class="numeric">Saldo</th></tr></thead><tbody><% for(const row of report.rows){ %><tr><td><%= dateTime(row.createdAt) %></td><td><%= row.name %></td><td><%= row.reason %></td><td class="numeric"><%= row.delta>0?'+':'' %><%= row.delta %></td><td class="numeric"><%= row.after %></td></tr><% } %></tbody></table></div><% }else{ %><div class="table-wrap"><table><thead><tr><th><%= report.type==='recebimentos'?'Forma de pagamento':'Produto / livro' %></th><th>Condição</th><th class="numeric"><%= report.type==='recebimentos'?'Comandas':'Quantidade' %></th><% if(report.type==='livraria'){ %><th class="numeric">Estoque</th><% } %><th class="numeric">Valor total</th></tr></thead><tbody><% for(const row of report.rows){ %><tr><td><strong><%= row.name %></strong><small class="cell-note"><%= row.code||'' %></small></td><td><%= row.condition||'—' %></td><td class="numeric"><%= row.quantity %></td><% if(report.type==='livraria'){ %><td class="numeric"><%= row.stock %></td><% } %><td class="numeric money"><%= money(row.totalCents) %></td></tr><% } %></tbody></table></div><% } %></section>
