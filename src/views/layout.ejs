<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light"><meta name="description" content="Administração da cantina e livraria Casinha Azul.">
  <title><%= title %> · Casinha Azul</title>
  <link rel="icon" type="image/png" href="/assets/images/logotipo-casinhazul.png">
  <link rel="stylesheet" href="/assets/css/app.css"><script src="/assets/js/app.js" defer></script>
</head>
<body>
<a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
<svg class="icon-library" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><defs>
  <symbol id="i-home" viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z"/></symbol>
  <symbol id="i-box" viewBox="0 0 24 24"><path d="m12 3 9 5v9l-9 5-9-5V8Zm0 9 9-4M12 12 3 8m9 4v10M7.5 5.5l9 5"/></symbol>
  <symbol id="i-book" viewBox="0 0 24 24"><path d="M12 5c-3-2-6-2-10-1v15c4-1 7-1 10 1 3-2 6-2 10-1V4c-4-1-7-1-10 1Zm0 0v15"/></symbol>
  <symbol id="i-receipt" viewBox="0 0 24 24"><path d="m5 3 2 1 2-1 3 1 3-1 2 1 2-1v18l-3-1-4 1-4-1-3 1Zm3 5h8m-8 4h8m-8 4h5"/></symbol>
  <symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 3v17h17M8 16v-5m5 5V6m5 10V9"/></symbol>
  <symbol id="i-settings" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/><circle cx="8" cy="6" r="2"/><circle cx="16" cy="12" r="2"/><circle cx="10" cy="18" r="2"/></symbol>
  <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
  <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
  <symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></symbol>
  <symbol id="i-stock" viewBox="0 0 24 24"><path d="M4 4h16v16H4Zm0 6h16M8 7h2m-2 6h2m-2 4h2"/></symbol>
  <symbol id="i-sync" viewBox="0 0 24 24"><path d="M20 7a9 9 0 0 0-15-2L3 8m0-5v5h5m-4 9a9 9 0 0 0 15 2l2-3m0 5v-5h-5"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
  <symbol id="i-download" viewBox="0 0 24 24"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"/></symbol>
  <symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="7" r="4"/><path d="M2 21v-3a7 7 0 0 1 14 0v3m1-18a4 4 0 0 1 0 8m3 10v-3a7 7 0 0 0-3-6"/></symbol>
</defs></svg>
<header class="app-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Casinha Azul, início"><span class="brand-mark"><img src="/assets/images/logotipo-casinhazul.png" alt="Logo Casinha Azul" width="61" height="57"></span><span><strong>Casinha Azul</strong><small>CANTINA & LIVRARIA</small></span></a>
    <span class="header-label">Painel administrativo</span>
    <div class="header-tools"><button type="button" class="font-control" data-font-toggle aria-label="Aumentar tamanho das letras" aria-pressed="false">A<span>+</span></button><span class="mode-pill"><span class="dot"></span><%= mode === 'demo' ? 'Demonstração' : 'MongoDB' %></span></div>
  </div>
  <nav class="main-nav" aria-label="Menu principal"><div class="nav-inner">
  <% const nav = [['/','home','Início'],['/cantina','box','Cantina'],['/livraria','book','Livraria'],['/comandas','receipt','Comandas'],['/relatorios','chart','Relatórios'],['/configuracoes','settings','Configurações']]; %>
  <% for (const [url,icon,label] of nav) { const current = url === '/' ? path === '/' : path.startsWith(url); %>
    <a href="<%= url %>" class="nav-link <%= current ? 'active' : '' %>" <%- current ? 'aria-current="page"' : '' %>><svg class="icon" aria-hidden="true"><use href="#i-<%= icon %>"/></svg><%= label %></a>
  <% } %>
  <a class="nav-stock <%= path === '/estoque' ? 'active' : '' %>" href="/estoque"><svg class="icon" aria-hidden="true"><use href="#i-stock"/></svg>Estoque</a>
  </div></nav>
</header>
<main id="conteudo" class="main-container" tabindex="-1">
  <% if (mode === 'demo') { %><div class="demo-banner"><span class="dot"></span><strong>Ambiente de demonstração</strong><span>Dados de exemplo. Alterações ficam somente nesta execução.</span></div><% } %>
  <% if (notice) { %><div role="status" class="notice success"><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg><%= notice %></div><% } %>
  <%- include(page) %>
</main>
<footer class="app-footer"><div><span class="footer-brand">Casinha Azul<sup>™</sup></span><span class="footer-description">Cuidar também é organizar.</span></div><a href="mailto:hiratabruno@yahoo.com">desenvolvido por <strong>Nebule Tech Consulting</strong></a><span class="copyright">© <%= year %></span></footer>
<dialog id="confirm-dialog" class="confirm-dialog" aria-labelledby="confirm-title"><form method="dialog"><div class="dialog-icon"><svg class="icon" aria-hidden="true"><use href="#i-receipt"/></svg></div><h2 id="confirm-title">Confirmar alteração</h2><p id="confirm-message"></p><div class="form-actions"><button class="button secondary" value="cancel">Cancelar</button><button class="button" value="confirm">Confirmar</button></div></form></dialog>
<div class="toast" role="status" aria-live="polite" hidden></div>
</body></html>
