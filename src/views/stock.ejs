<section class="page-heading"><div><p class="eyebrow">DISPONIBILIDADE</p><h1>Controle de estoque</h1><p class="subtitle">Cada entrada, saída e ajuste com seu motivo registrado.</p></div><a class="button secondary" href="/relatorios?type=estoque">Ver estoque mínimo</a></section>
<div class="two-column"><section class="panel form-panel"><h2>Registrar movimentação</h2><form method="get" class="stack-form"><label>Selecione o produto ou livro<select name="ref" required><option value="">Escolher um item…</option><% for(const item of items){ %><option value="<%= item.kind %>:<%= item._id %>" <%= selected?._id===item._id?'selected':'' %>><%= item.name %><%= item.condition?' · '+item.condition:'' %> — <%= item.stock %> un.</option><% } %></select></label><button class="button secondary">Selecionar</button></form>
<% if(selected){ %><div class="selected-record"><strong><%= selected.name %></strong><span>Estoque atual: <b><%= selected.stock %> unidades</b></span></div><form class="stack-form" method="post" action="/estoque" data-confirm="Registrar esta movimentação de estoque?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="kind" value="<%= selected.kind %>"><input type="hidden" name="id" value="<%= selected._id %>"><input type="hidden" name="version" value="<%= selected.version %>"><input type="hidden" name="operationId" value="<%= operationId %>"><label>Tipo de movimentação<select name="type"><option value="entrada">Entrada · compra ou doação</option><option value="saida">Saída · perda ou retirada</option><option value="contagem">Correção · informar saldo contado</option></select></label><label>Quantidade<input type="number" name="quantity" min="0" max="1000000" required step="1"><small>Na correção, informe o saldo final, inclusive zero.</small></label><label>Motivo<textarea name="reason" required minlength="3" maxlength="300" rows="3" placeholder="Ex.: doação recebida, reposição ou correção de contagem"></textarea></label><button class="button">Registrar movimentação</button></form><% }else{ %><p class="form-help">Escolha um cadastro para registrar uma movimentação. Itens novos começam com saldo zero.</p><% } %></section>
<section class="panel"><div class="panel-heading"><div><h2>Últimas movimentações</h2><p>Histórico preservado, sem apagar registros</p></div></div><% if(!movements.length){ %><%- include('partials/empty',{message:'Nenhuma movimentação registrada.',detail:'As entradas, saídas e correções aparecerão aqui.'}) %><% }else{ %><div class="movement-list"><% for(const movement of movements){ %><article><span class="movement-delta <%= movement.delta>=0?'positive-text':'amber-text' %>"><%= movement.delta>0?'+':'' %><%= movement.delta %></span><div><strong><%= movement.name %></strong><p><%= movement.reason %></p><small><%= movement.before %> → <%= movement.after %> unidades · <%= dateTime(movement.createdAt) %></small></div></article><% } %></div><% } %></section></div>
