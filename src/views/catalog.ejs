<section class="page-heading"><div><p class="eyebrow">CATÁLOGO DA CASA</p><h1><%= title %></h1><p class="subtitle"><%= kind==='books'?'Novos e usados, com cada exemplar no seu lugar.':'Produtos, preços e disponibilidade para o atendimento.' %></p></div><div class="heading-actions"><a class="button secondary" href="/precos?kind=<%= kind %>">Reajustar preços</a><a class="button" href="<%= base %>/novo"><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg><%= kind==='books'?'Cadastrar livro':'Novo produto' %></a></div></section>
<% if(kind==='books'){ %><div class="info-note"><svg class="icon" aria-hidden="true"><use href="#i-book"/></svg>Livros usados: custo de doação zero e venda fixa de <strong>R$ 10,00</strong>. Novos seguem os preços do cadastro.</div><% } %>
<section class="panel"><form class="filter-bar" method="get"><label class="search-field"><svg class="icon" aria-hidden="true"><use href="#i-search"/></svg><span class="sr-only">Buscar <%= kind==='books'?'título, autor ou ISBN':'produto ou código' %></span><input name="q" value="<%= search %>" placeholder="<%= kind==='books'?'Buscar título, autor ou ISBN…':'Buscar produto ou código…' %>" maxlength="120"></label><% if(kind==='products'){ %><label><span class="sr-only">Categoria</span><select name="category"><option value="">Todas as categorias</option><% for(const [key,label] of Object.entries(categories)){ %><option value="<%= key %>" <%= query.category===key?'selected':'' %>><%= label %></option><% } %></select></label><% }else{ %><label><span class="sr-only">Condição</span><select name="condition"><option value="">Novos e usados</option><option value="novo" <%= query.condition==='novo'?'selected':'' %>>Novos</option><option value="usado" <%= query.condition==='usado'?'selected':'' %>>Usados</option></select></label><% } %><label><span class="sr-only">Situação</span><select name="status"><option value="ativos">Ativos</option><option value="inativos" <%= query.status==='inativos'?'selected':'' %>>Inativos</option><option value="todos" <%= query.status==='todos'?'selected':'' %>>Todos</option></select></label><button class="button secondary" type="submit">Filtrar</button><% if(Object.keys(query).some(k=>k!=='notice')){ %><a class="text-link" href="<%= base %>">Limpar</a><% } %></form>
<div class="table-caption"><h2><%= kind==='books'?'Acervo':'Produtos e preços' %></h2><span><%= total %> registros encontrados</span></div>
<% if(!rows.length){ %><%- include('partials/empty',{message:'Nenhum registro encontrado.',detail:mode==='demo'?'Experimente outra busca ou cadastre um novo item.':'Cadastre o primeiro item ou importe o catálogo de referência pelo comando documentado.'}) %><% }else{ %><div class="table-wrap"><table><thead><tr><th><%= kind==='books'?'Livro / ISBN':'Produto / código' %></th><th><%= kind==='books'?'Condição':'Categoria' %></th><th class="numeric">Custo</th><th class="numeric">Venda</th><th class="numeric">Estoque</th><th>Situação</th><th>Ações</th></tr></thead><tbody><% for(const item of rows){ %><tr><td><div class="item-cell"><span class="item-symbol <%= kind==='books'?'purple':'blue' %>"><svg class="icon" aria-hidden="true"><use href="#i-<%= kind==='books'?'book':'box' %>"/></svg></span><div><a class="record-link" href="<%= base %>/<%= item._id %>/editar"><%= item.name %></a><small><%= item.isbn || item.code %></small></div></div></td><td><%= kind==='books'?(item.condition==='novo'?'Novo':'Usado'):(categories[item.category]||'Outros') %></td><td class="numeric"><%= money(item.costCents) %></td><td class="numeric money"><%= money(item.priceCents) %></td><td class="numeric"><span class="stock-number <%= item.stock<=item.minStock?'low':'' %>"><%= item.stock %></span><small class="cell-note">mín. <%= item.minStock %></small></td><td><span class="badge <%= item.active?'positive':'neutral' %>"><%= item.active?'Ativo':'Inativo' %></span><% if(item.active&&item.stock<=item.minStock){ %><small class="cell-note amber-text">Estoque baixo</small><% } %></td><td><div class="row-actions"><% if(item.active){ %><a href="<%= base %>/<%= item._id %>/editar" class="text-link">Editar</a><a href="/estoque?kind=<%= kind %>&id=<%= item._id %>" class="text-link">Estoque</a><% } %><form method="post" action="/catalogo/<%= kind %>/<%= item._id %>/situacao" data-confirm="<%= item.active?'Desativar':'Reativar' %> <%= item.name %>? O histórico será preservado."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= item.version %>"><button class="link-button <%= item.active?'muted':'' %>"><%= item.active?'Desativar':'Reativar' %></button></form></div></td></tr><% } %></tbody></table></div><% } %><%- include('partials/pagination') %></section>
